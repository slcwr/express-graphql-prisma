    "graphql": "^16.9.0",
    "next": "^15.5.21",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "styled-components": "^6.3.11",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.1.3",
