{
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && tsc",
    "watch": "tsc --watch",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "start": "tsx watch src/index.ts",
    "dev": "tsx watch src/index.ts",
    "codegen": "graphql-codegen --require dotenv/config --config codegen.yml",
    "codegen:watch": "graphql-codegen --watch",
    "prisma:init": "prisma init",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:db:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "deploy:prod": "prisma migrate deploy && npm run start",
    "db:seed": "prisma db seed",
    "test:reset-db": "prisma migrate reset --force && prisma db seed",
    "test": "jest",
    "test:e2e": "NODE_ENV=test jest --config jest.config.js",
    "db:reset": "NODE_ENV=test prisma migrate reset --force"
  },
  "dependencies": {
    "@apollo/datasource-rest": "^6.3.0",
    "@apollo/server": "^5.5.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.22.2",
    "express-validator": "^7.2.0",
    "graphql": "^16.9.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "^2.0.0-rc.2",
    "typescript": "^4.9.5",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.8",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/typescript": "^4.1.1",
    "@graphql-codegen/typescript-resolvers": "^4.4.0",
    "@prisma/client": "^5.22.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "babel-jest": "^29.7.0",
    "cypress": "^15.18.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typegraphql-prisma": "^0.28.0"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  }
}
